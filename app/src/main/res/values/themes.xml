<resources>
    <!-- Tema oscuro fijo: no depende del modo del sistema -->
    <style name="Theme.Pausa" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/moss</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <!-- Pantalla de fricción: negro total -->
    <style name="Theme.Pausa.Friction" parent="Theme.Pausa">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
</resources>
